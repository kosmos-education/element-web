            "mimeType": "text/html",
            "size": 1322,
            "text": "<!doctype html>\n<html lang=\"en\" style=\"height: 100%;\">\n  <head>\n    <meta charset=\"utf-8\">\n    <title>Element</title>\n    <link rel=\"apple-touch-icon\" sizes=\"120x120\" href=\"kosmos-icons/120.8b12590.png\">\n    <link rel=\"apple-touch-icon\" sizes=\"144x144\" href=\"kosmos-icons/144.41de32b.png\">\n    <link rel=\"apple-touch-icon\" sizes=\"152x152\" href=\"kosmos-icons/152.3326835.png\">\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"kosmos-icons/180.6ca9d77.png\">\n    <link rel=\"manifest\" href=\"manifest.json\">\n    <meta name=\"referrer\" content=\"no-referrer\">\n    <link rel=\"icon\" type=\"image/png\" sizes=\"24x24\" href=\"kosmos-icons/24.fa02496.png\">\n    <link rel=\"icon\" type=\"image/png\" sizes=\"144x144\" href=\"kosmos-icons/144.41de32b.png\">\n    <link rel=\"icon\" type=\"image/png\" sizes=\"512x512\" href=\"kosmos-icons/512.5a748a7.png\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"apple-mobile-web-app-title\" content=\"Element\">\n    <meta name=\"application-name\" content=\"Element\">\n    <meta name=\"theme-color\" content=\"#ffffff\">\n    <meta property=\"og:image\" content=\"https://app.element.io/themes/element/img/logos/opengraph.png\" />\n    <meta http-equiv=\"Content-Security-Policy\" content=\"\n        default-src 'none';\n        style-src 'self' 'unsafe-inline' ;\n        script-src 'self' 'wasm-unsafe-eval' https://www.recaptcha.net/recaptcha/ https://www.gstatic.com/recaptcha/ ;\n        img-src * blob: data:;\n        connect-src * blob:;\n        font-src 'self' data: ;\n        media-src * blob: data:;\n        child-src * blob: data:;\n        worker-src 'self' blob: ;\n        frame-src * blob: data:;\n        form-action 'self' ;\n        manifest-src 'self' ;\n    \">\n    \n           <link rel=\"stylesheet\" href=\"bundles/45c4819363b407d1357a/bundle.css\">\n        \n           <link rel=\"stylesheet\" disabled=\"di