/* Variables PostCSS (legacy) pour le thème Skolengo
 * Ce fichier est partagé par skolengo-light et skolengo-dark.
 * Il doit être importé APRÈS _light.pcss (et _dark.pcss le cas échéant) pour surcharger,
 * et AVANT _components.pcss pour que les composants lisent les bonnes valeurs.
 * Les valeurs référencent var(--cpd-color-indigo-*) qui s'adaptent automatiquement
 * au mode clair/sombre selon l'échelle définie dans _skolengo-tokens.pcss.
 */

/* Palette d'accent → IndigoEMS (au lieu de green) */
/* ******************** */
$accent-100: var(--cpd-color-indigo-100);
$accent-200: var(--cpd-color-indigo-200);
$accent-300: var(--cpd-color-indigo-300);
$accent-400: var(--cpd-color-indigo-400);
$accent-500: var(--cpd-color-indigo-500);
$accent-600: var(--cpd-color-indigo-600);
$accent-700: var(--cpd-color-indigo-700);
$accent-800: var(--cpd-color-indigo-800);
$accent-900: var(--cpd-color-indigo-900);
$accent-1000: var(--cpd-color-indigo-1000);
$accent-1100: var(--cpd-color-indigo-1100);
$accent-1200: var(--cpd-color-indigo-1200);
$accent-1300: var(--cpd-color-indigo-1300);
$accent-1400: var(--cpd-color-indigo-1400);
/* ******************** */

/* Surfaces teintées périvenche */
/* ******************** */
/* Room list : indigo-300 ≈ #edf1ff (correspond à la maquette #eff3ff) */
/* NOTE : pilote l'ANCIENNE UI (legacy room list) uniquement. La nouvelle UI (v1.12.21+,
 * feature_new_room_list) ignore ces variables et utilise --cpd-color-bg-canvas-default.
 * Les fonds périvenche de la nouvelle UI sont définis dans _skolengo-overrides.pcss. */
$roomlist-bg-color: var(--cpd-color-indigo-300);
/* Space panel (barre latérale) : indigo-400 ≈ #dde5ff (correspond à la maquette #d4deff) */
/* Même remarque : pilote l'ancienne UI seulement. Voir _skolengo-overrides.pcss. */
$spacePanel-bg-color: var(--cpd-color-indigo-400);
/* ******************** */

/* Bulles de messages */
/* ******************** */
/* Bulle de mes propres messages : indigo-400 ≈ #dde5ff (conforme maquette) */
$eventbubble-self-bg: var(--cpd-color-indigo-400);
/* ******************** */

/* Réactions */
/* ******************** */
/* Réaction sélectionnée → teinte indigo légère */
$reaction-row-button-selected-bg-color: var(--cpd-color-indigo-200);
/* ******************** */
