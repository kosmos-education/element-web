/* Surcharges de sélecteurs app — fonds périvenche des panneaux latéraux
 * Partagé par skolengo-light et skolengo-dark.
 *
 * Depuis la v1.12.21, la nouvelle UI (feature_new_room_list) code en dur
 * --cpd-color-bg-canvas-default sur ces conteneurs ; les variables legacy
 * $roomlist-bg-color / $spacePanel-bg-color n'ont plus d'effet. On repeint
 * directement le background-color sur les sélecteurs de conteneur.
 *
 * IMPORTANT : on ne redéfinit PAS --cpd-color-bg-canvas-default globalement car
 * il est aussi utilisé par la timeline (doit rester blanche), par la barre de
 * recherche (Button secondary, doit ressortir en blanc sur le périvenche) et par
 * les en-têtes de section sticky.
 *
 * Les var(--cpd-color-indigo-*) s'adaptent automatiquement au mode clair/sombre
 * via l'échelle inversée définie dans _skolengo-tokens.pcss de chaque thème.
 */

/* Left panel (conteneur global nouvelle UI) — possède un !important d'origine */
.mx_LeftPanel_newRoomList {
    background-color: var(--cpd-color-indigo-300) !important;
}

/* Space panel (barre d'espaces latérale) — légèrement plus saturé (≈ #dde5ff maquette) */
.mx_SpacePanel.newUi {
    background-color: var(--cpd-color-indigo-400);
}

/* Room list panel (liste des salons + header + filtres) — périvenche clair ≈ #edf1ff */
.mx_RoomListPanel {
    background-color: var(--cpd-color-indigo-300);
}

/* Panneau de droite (infos salon / liste des membres) — périvenche clair */
.mx_RightPanel {
    background-color: var(--cpd-color-indigo-300);
}

/* ── Avatars ──────────────────────────────────────────────────────────────── */

/* Initiales en blanc sur fonds décoratifs saturés.
 * Ne touche PAS --cpd-color-text-decorative-* : les noms d'auteurs dans la
 * timeline restent colorés (ils n'utilisent pas --cpd-avatar-color). */
.mx_BaseAvatar {
    --cpd-avatar-color: #fff;
}

/* Avatars de SALONS en carré arrondi — liste et en-tête uniquement.
 * Les avatars d'auteurs dans les messages restent ronds.
 * Compound applique border-radius via --cpd-avatar-radius sur .avatar[data-type].
 * On surcharge la variable sur .mx_BaseAvatar pour gagner en spécificité. */
.mx_RoomListItemView .mx_RoomAvatarView .mx_BaseAvatar,
.mx_RoomHeader .mx_BaseAvatar {
    --cpd-avatar-radius: 25%;
}

/* ── Liste des salons ─────────────────────────────────────────────────────── */

/* Nom du salon : plus foncé et légèrement plus gras (maquette).
 * data-testid="room-name" est le seul sélecteur stable sur cet élément
 * (la classe CSS module est hashée à la compilation). */
.mx_RoomListItemView [data-testid="room-name"] {
    color: var(--cpd-color-text-primary);
    font-weight: var(--cpd-font-weight-medium);
}

/* ── En-tête du salon ─────────────────────────────────────────────────────── */

/* Titre du salon (RoomHeader) : plus d'épaisseur.
 * Compound pose la graisse via font: shorthand sur .cpd-text-heading-lg-semibold ;
 * !important nécessaire pour la surcharge. */
.mx_RoomHeader .mx_RoomHeader_heading {
    font-weight: var(--cpd-font-weight-bold) !important;
}
