/* Thème Skolengo — mode sombre
 * Choix produit : le mode sombre repart du thème dark d'Element PAR DÉFAUT.
 * Contrairement au thème clair, on ne réimporte donc PAS les surcharges de marque
 * partagées (_skolengo-vars.pcss / _skolengo-overrides.pcss) : accent, fonds de
 * panneaux périvenche, bulles « moi », filtres et noms de salons reviennent aux
 * couleurs Compound/Element par défaut.
 * On conserve UNIQUEMENT l'identité visuelle des avatars via deux fichiers dédiés
 * au sombre : _skolengo-dark-overrides.pcss (initiales blanches, forme carrée,
 * logo, contours d'espace) et _skolengo-tokens.pcss (couleurs bg/text-decorative).
 *
 * La liste d'imports ci-dessous est identique à dark/css/dark.pcss, augmentée des
 * deux imports Skolengo.
 */
@layer compound-tokens, compound-web, shared-components, app-web;

@import "../../../../res/css/_font-sizes.pcss" layer(app-web);
@import "../../light/css/_fonts.pcss" layer(app-web);
@import "../../light/css/_light.pcss" layer(app-web);
@import "../../dark/css/_dark.pcss" layer(app-web);
@import "../../light/css/_mods.pcss" layer(app-web);
@import "../../../../res/css/_components.pcss" layer(app-web);
/* Surcharges sélecteurs app : uniquement identité avatars (couleurs, forme), logo, contours d'espace */
@import "_skolengo-dark-overrides.pcss" layer(app-web);
@import "../../../../res/css/_compound.pcss";
/* Tokens CSS de marque Skolengo — uniquement couleurs décoratives (avatars, noms d'auteurs) */
@import "_skolengo-tokens.pcss";
@import url("highlight.js/styles/atom-one-dark.min.css") layer(app-web);
@import url("github-markdown-css/github-markdown-dark.css") layer(app-web);
