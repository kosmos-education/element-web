/* Surcharges de sélecteurs app — fonds périvenche des panneaux latéraux
 * Partagé par la-bulle-light et la-bulle-dark.
 *
 * Depuis la v1.12.21, la nouvelle UI (feature_new_room_list) code en dur
 * --cpd-color-bg-canvas-default sur ces conteneurs ; les variables legacy
 * $roomlist-bg-color / $spacePanel-bg-color n'ont plus d'effet. On repeint
 * directement le background-color sur les sélecteurs de conteneur.
 *
 * IMPORTANT : on ne redéfinit PAS --cpd-color-bg-canvas-default globalement car
 * il est aussi utilisé par la timeline (doit rester blanche), par la barre de
 * recherche (Button secondary, doit ressortir en blanc sur le périvenche) et par
 * les en-têtes de section sticky.
 *
 * Les var(--cpd-color-indigo-*) s'adaptent automatiquement au mode clair/sombre
 * via l'échelle inversée définie dans _skolengo-tokens.pcss de chaque thème.
 */

/* Fonds des panneaux découplés par mode via des variables de marque définies dans
 * chaque _skolengo-tokens.pcss (clair = valeurs actuelles inchangées ; sombre = teintes
 * indigo abaissées pour un rendu sobre) :
 * - --skolengo-panel-bg      : clair indigo-300 #edf1ff / sombre indigo-200 #241782
 * - --skolengo-spacepanel-bg : clair indigo-400 #dde5ff / sombre indigo-300 #3425ac */

/* Left panel (conteneur de la liste de salons).
 * v1.12.26 : `.mx_LeftPanel_newRoomList` a disparu au profit de
 * `.mx_LeftPanel_roomListContainer`, et l'amont n'y pose plus de fond blanc
 * `!important` — la surcharge n'a donc plus besoin d'`!important`. */
.mx_LeftPanel_roomListContainer {
    background-color: var(--skolengo-panel-bg);
}

/* Space panel (barre d'espaces latérale) — légèrement plus saturé que les listes.
 * v1.12.26 : le fond blanc est passé de `.mx_SpacePanel.newUi` à `.mx_SpacePanel`. */
.mx_SpacePanel {
    background-color: var(--skolengo-spacepanel-bg);
}

/* Room list panel (liste des salons + header + filtres) — teinte périvenche */
.mx_RoomListPanel {
    background-color: var(--skolengo-panel-bg);
}

/* Panneau de droite (infos salon / liste des membres) — teinte périvenche */
.mx_RightPanel {
    background-color: var(--skolengo-panel-bg);
}

/* ── Avatars ──────────────────────────────────────────────────────────────── */

/* Initiales en blanc sur fonds décoratifs saturés — avatars avec classe mx_BaseAvatar.
 * Ne touche PAS --cpd-color-text-decorative-* : les noms d'auteurs dans la
 * timeline restent colorés (ils n'utilisent pas --cpd-avatar-color).
 * !important nécessaire : .avatar[data-color] (0,2,0) bat .mx_BaseAvatar (0,1,0). */
.mx_BaseAvatar {
    --cpd-avatar-color: #fff !important;
}

/* Avatar de l'utilisateur courant (UserMenu, haut du space panel).
 * Ce composant utilise Compound <Avatar> directement (sans mx_BaseAvatar).
 * On cible [data-color] qui est stable (survit au hash CSS module).
 * Sans effet sur une photo uploadée (pas d'initiale dans ce cas).
 * Seul l'avatar déclencheur (36px, resté dans .mx_UserMenu) est couvert ici. */
.mx_UserMenu [data-color] {
    --cpd-avatar-color: #fff !important;
}

/* Avatar dans le portail d'un menu Compound (ex. modale UserMenu au clic sur l'avatar).
 * Le contenu du <Menu> Compound est rendu hors de .mx_UserMenu via un portail Radix
 * (<div role="menu"> attaché à document.body) → la règle ci-dessus ne l'atteint pas.
 * On force ici l'initiale en blanc sur le fond décoratif saturé (Skolengo).
 * Sans effet sur une photo uploadée. */
[role="menu"] [data-color] {
    --cpd-avatar-color: #fff !important;
}

/* Avatars de SALONS en carré arrondi — liste, avatar de l'en-tête, room summary panel et
 * modale de paramétrage du salon.
 * On cible .mx_BaseAvatar directement : RoomAvatarView ne rend le wrapper
 * .mx_RoomAvatarView QUE si l'avatar a une décoration ; sinon <RoomAvatar> nu.
 * En-tête : WithPresenceIndicator renvoie un Fragment (sans nœud DOM) quand
 * il n'y a pas de présence → l'avatar est l'enfant DIRECT de .mx_RoomHeader.
 * On couvre les deux cas : enfant direct ET descendant du wrapper de présence.
 * Room summary panel : <RoomAvatar size="80px"> nu dans .mx_RoomSummaryCard_container ;
 * RoomAvatar n'envoie "square" que pour les Espaces → sans cette règle le salon
 * resterait rond.
 * Modale de paramétrage du salon (onglet Général) : AvatarSetting est partagé avec le
 * profil utilisateur, on ne peut donc pas le cibler par sa classe seule —
 * .mx_RoomSettingsDialog restreint la règle au salon, le profil utilisateur reste rond.
 * La règle amont `.mx_AvatarSetting_avatar > img { border-radius: 120px }` ne s'applique
 * pas (l'<img> est rendu par BaseAvatar, sous .mx_AvatarSetting_avatarDisplay) : le rayon
 * vient bien du token Compound.
 * Message d'accueil du salon (NewRoomIntro, haut de la timeline d'un salon neuf) :
 * <RoomAvatar size=AVATAR_SIZE> nu, ou enveloppé dans MiniAvatarUploader quand le salon
 * n'a pas encore d'avatar — on cible .mx_BaseAvatar en descendant pour couvrir les deux.
 * La branche 1-1 de ce composant utilise aussi <RoomAvatar>, donc elle passe en carré
 * elle aussi : c'est cohérent avec .mx_RoomListItemView, où les 1-1 sont déjà carrés.
 * !important nécessaire : .avatar[data-type="round"] (0,2,0) bat les sélecteurs
 * descendants sans !important. */
.mx_RoomListItemView .mx_BaseAvatar,
.mx_RoomHeader > *:first-child.mx_BaseAvatar,
.mx_RoomHeader > *:first-child .mx_BaseAvatar,
.mx_RoomSummaryCard_container .mx_BaseAvatar,
.mx_RoomSettingsDialog .mx_AvatarSetting_avatar .mx_BaseAvatar,
.mx_NewRoomIntro .mx_BaseAvatar {
    --cpd-avatar-radius: 25% !important;
}

/* Espaces (barre de gauche) : contour intégré à la couleur de chaque espace.
 * Logique native : inactif = padding 4px, actif = padding 1px + border 3px = 4px.
 * On pose padding:1px + border 3px pour conserver le total (4px) inactif/actif.
 * Bordure : rgba(0,0,0,.25) — semi-transparent noir ; comme background-clip vaut
 * border-box, le fond coloré du selectionWrapper transparaît sous la bordure →
 * résultat : couleur de l'espace assombrie de ~25 %, sans saut d'alignement.
 * Les 6 règles :has() posent le fond selon data-color de l'avatar (Compound Avatar
 * pose toujours data-color="N" sur .mx_BaseAvatar, N ∈ 1..6).
 * La règle native active (spécificité 0,4,0, sans !important) continue de prendre
 * le dessus pour border-color → le liseré de sélection reste visible.
 * On N'utilise PAS !important afin de ne pas bloquer la règle active native. */
.mx_SpacePanel .mx_SpaceButton_narrow .mx_SpaceButton_selectionWrapper {
    padding: 1px;
    border: 3px solid transparent;
}

.mx_SpacePanel .mx_SpaceButton_active .mx_SpaceButton_selectionWrapper:has(span[data-color="1"]) {
    background-color: var(--cpd-color-bg-decorative-1);
    border: 3px solid rgba(0, 0, 0, 0.25);
}

.mx_SpacePanel .mx_SpaceButton_active .mx_SpaceButton_selectionWrapper:has(span[data-color="2"]) {
    background-color: var(--cpd-color-bg-decorative-2);
    border: 3px solid rgba(0, 0, 0, 0.25);
}

.mx_SpacePanel .mx_SpaceButton_active .mx_SpaceButton_selectionWrapper:has(span[data-color="3"]) {
    background-color: var(--cpd-color-bg-decorative-3);
    border: 3px solid rgba(0, 0, 0, 0.25);
}

.mx_SpacePanel .mx_SpaceButton_active .mx_SpaceButton_selectionWrapper:has(span[data-color="4"]) {
    background-color: var(--cpd-color-bg-decorative-4);
    border: 3px solid rgba(0, 0, 0, 0.25);
}

.mx_SpacePanel .mx_SpaceButton_active .mx_SpaceButton_selectionWrapper:has(span[data-color="5"]) {
    background-color: var(--cpd-color-bg-decorative-5);
    border: 3px solid rgba(0, 0, 0, 0.25);
}

.mx_SpacePanel .mx_SpaceButton_active .mx_SpaceButton_selectionWrapper:has(span[data-color="6"]) {
    background-color: var(--cpd-color-bg-decorative-6);
    border: 3px solid rgba(0, 0, 0, 0.25);
}

/* ── Recherche du room summary panel ──────────────────────────────────────── */

/* Champ de recherche du room summary panel homogénéisé en blanc, comme celui de
 * la liste des salons (RoomListSearchView = Button secondary → fond
 * --cpd-color-bg-canvas-default).
 * Le Compound <Search> ne pose aucun background → il laisse voir le périvenche du
 * .mx_RightPanel (--skolengo-panel-bg). On repeint le fond blanc sur la pastille
 * elle-même (le <label>.search, porteur de la classe stable .mx_no_textinput passée
 * en className) pour respecter son border-radius ; l'<input> interne a
 * background:inherit → il devient blanc lui aussi.
 * Light uniquement : --cpd-color-bg-canvas-default = blanc en clair et n'est jamais
 * redéfini globalement (cf. entête de fichier) → même source de blanc que la room list. */
.mx_RoomSummaryCard_search .mx_no_textinput {
    background-color: var(--cpd-color-bg-canvas-default);
}

/* ── Menubar du room summary panel : fond des items transparent ─────────────── */

/* Les MenuItem/ToggleMenuItem Compound ont un fond BLANC au repos
 * (--cpd-color-bg-action-secondary-rest = theme-bg = #fff), qui ressort en blanc
 * sur le panneau périvenche. On repointe, dans le seul scope du menubar :
 *
 *  1. le fond de repos → transparent : les items se fondent dans le panneau ;
 *  2. le fond de hover → indigo-400 (#dde5ff) : le hover Compound par défaut
 *     (alpha-gray à 4 % d'opacité) est quasi imperceptible sur le périvenche ; une
 *     teinte indigo douce le rend visible et reste dans l'identité de marque ;
 *  3. le texte secondaire → gray-1000 (#595e67) : les compteurs / nav-hints
 *     (text-secondary = gray-900) tombaient à ~4,4:1 sur le hover indigo ; gray-1000
 *     les remonte à ≥ 5:1.
 *
 * L'état critique (report/leave) garde son hover rouge (--cpd-color-bg-critical-subtle,
 * token distinct) ; l'état pressé garde le token pressed Compound.
 *
 * Contrastes RGAA AA (mode clair) :
 *  - labels (text-primary #1b1d22)  : ~15:1 (repos) / ~13:1 (hover indigo-400) ✓
 *  - secondaire (gray-1000 #595e67) : ~5,8:1 (repos) / ~5,2:1 (hover indigo-400) ✓ */
.mx_RoomSummaryCard [role="menubar"] {
    --cpd-color-bg-action-secondary-rest: transparent;
    --cpd-color-bg-action-secondary-hovered: var(--cpd-color-indigo-400);
    --cpd-color-text-secondary: var(--cpd-color-gray-1000);
}

/* Pastilles de filtre désélectionnées (Non-lus, Salons, Favoris, Mentions).
 * Compound ChatFilter : désélectionné = fond transparent, bord gris, texte sombre.
 * La classe CSS module est hashée → sélecteurs stables data-testid + role/aria.
 * Sélectionné : déjà indigo-900 + texte blanc via --cpd-color-bg-action-primary-rest.
 * Bordure indigo-800 : ≥ 3:1 contre panneau indigo-300 dans les 2 modes (RGAA crit. 3.3).
 * clair #747aff vs #edf1ff = 3,12:1 ✓ ; sombre #98a6ff vs #3425ac = 4,6:1 ✓. */
[data-testid="primary-filters"] [role="option"]:not([aria-selected="true"]) {
    background-color: var(--cpd-color-indigo-300);
    border-color: var(--cpd-color-indigo-800);
}

/* ── Pastilles de messages non lus ────────────────────────────────────────── */

/* UnreadCounter Compound : fond --cpd-color-icon-success-primary (vert) → indigo-900.
 * Texte --cpd-color-text-on-solid-primary = blanc en clair (theme-bg = #fff → 5,27:1 ✓),
 * sombre = #101317 sur #b2c0ff (indigo-900 dark) → 10,5:1 ✓. RGAA AA conforme.
 * indigo-600 clair (#b2c0ff) était insuffisant (1,77:1 — non conforme RGAA AA). */
[data-testid="notification-decoration"] {
    --cpd-color-icon-success-primary: var(--cpd-color-indigo-900);
}

/* ── Logo Skolengo ────────────────────────────────────────────────────────── */

/* Logo Skolengo sur fond blanc : l'<img> est posé nu sur le space panel indigo-400.
 * box-sizing:border-box préserve l'emprise 36×36 existante malgré le padding. */
.mx_SpacePanel .mx_SpacePanel_logo {
    background-color: #fff;
    border-radius: 16px;
    padding: 8px;
    box-sizing: border-box;
}

/* ── Liste des salons ─────────────────────────────────────────────────────── */

/* En-têtes de section (« Favoris », « Discussions »…) : fond de la liste.
 *
 * L'amont peint un fond OPAQUE sur chaque ligne d'en-tête et sur le calque
 * épinglé, car ces en-têtes sont `position: sticky` et se recouvrent en
 * défilant (sans fond opaque, les textes se superposent) :
 *   - GroupedVirtualizedList.module.css → `.stickyRow`         (lignes réelles)
 *   - RoomListSectionHeaderView.module.css → `.stickyBackground::before`
 *     (calque « section courante » épinglé en haut)
 * Les deux utilisent --cpd-color-bg-canvas-default (= blanc en clair), ce qui
 * dessinait une bande blanche en travers du périvenche du panneau. On repointe
 * sur --skolengo-panel-bg : l'opacité est conservée (exigence de l'amont), mais
 * la bande se fond dans la liste.
 *
 * Ces classes sont des CSS modules hashés (ex. `_stickyRow_3tgsb_23`) ; seule la
 * sous-chaîne est stable → sélecteur en [class*=], comme pour `.icon-button`
 * dans _la-bulle-tokens.pcss.
 *
 * Mode sombre : non concerné. la-bulle-dark ne repeint pas .mx_RoomListPanel, le
 * fond de la liste EST déjà --cpd-color-bg-canvas-default. */
.mx_RoomListPanel [class*="stickyRow"] {
    background: var(--skolengo-panel-bg);
}

.mx_RoomListPanel [class*="stickyBackground"]::before {
    background: var(--skolengo-panel-bg);
}

/* Taille de police des en-têtes de section alignée sur celle des salons.
 * L'amont met les en-têtes en body-sm (13px) et les tuiles de salon en body-md
 * (15px) → rupture d'échelle dans une même liste. On ne surcharge QUE la taille
 * et le crénage : la graisse (regular / semibold quand la section est non lue)
 * reste celle de l'amont, ce qui préserve la hiérarchie visuelle.
 *
 * On surcharge `font-size` (et non le raccourci `font`) : la règle vit dans le
 * layer app-web, déclaré APRÈS shared-components (cf. @layer de la-bulle-light.pcss),
 * donc elle l'emporte déclaration par déclaration — y compris sur le `font:`
 * raccourci de `.header.unread`, sans !important ni course à la spécificité. */
.mx_RoomListPanel [class*="stickyRow"] button,
.mx_RoomListPanel [class*="stickyBackground"] button {
    font-size: var(--cpd-font-size-body-md);
    letter-spacing: var(--cpd-font-letter-spacing-body-md);
}

/* Survol et sélection des tuiles de salon : teintes assombries.
 *
 * Les valeurs globales de _la-bulle-tokens.pcss (survol indigo-200 #f6f8ff,
 * sélection indigo-300 #edf1ff) ont été calées sur un fond de liste blanc. Depuis
 * que le panneau est en périvenche (--skolengo-panel-bg = indigo-300 #edf1ff) :
 *   - la sélection est STRICTEMENT de la même couleur que le fond → invisible,
 *     seul le liseré de 4px à gauche trahissait le salon courant ;
 *   - le survol est plus CLAIR que le fond → effet inversé, illisible.
 * On descend donc d'un cran chacun, dans le seul scope de la liste des salons :
 * survol indigo-400 (#dde5ff), sélection indigo-500 (#c4d0ff). La sélection
 * reste ainsi distinguable du survol, et les deux du fond.
 *
 * Scope volontairement limité à .mx_RoomListPanel : ces deux tokens Compound
 * pilotent aussi les boutons/menus tertiaires du reste de l'app, posés sur fond
 * blanc, où les valeurs globales restent correctes.
 *
 * L'en-tête de section hérite du même survol (il consomme tertiary-hovered).
 *
 * Contrastes RGAA AA : survolée comme sélectionnée, la tuile passe son texte en
 * --cpd-color-text-primary (#1b1d22) → 12,9:1 sur #c4d0ff et 15,3:1 sur #dde5ff ✓.
 *
 * Sélecteur qualifié `nav.` (RoomListPanel est rendu en <nav>) plutôt que
 * `.mx_RoomListPanel` seul, pour ne pas dupliquer le sélecteur déjà utilisé plus
 * haut par le fond du panneau (stylelint no-duplicate-selectors). */
nav.mx_RoomListPanel {
    --cpd-color-bg-action-tertiary-hovered: var(--cpd-color-indigo-400);
    --cpd-color-bg-action-tertiary-selected: var(--cpd-color-indigo-500);
}

/* Nom du salon : plus foncé et légèrement plus gras (maquette).
 * data-testid="room-name" est le seul sélecteur stable sur cet élément
 * (la classe CSS module est hashée à la compilation). */
.mx_RoomListItemView [data-testid="room-name"] {
    color: var(--cpd-color-text-primary);
    font-weight: var(--cpd-font-weight-medium);
}

/* ── Texte secondaire sur les bulles « moi » ─────────────────────────────── */

/* La bulle « moi » est en périvenche pâle (#dde5ff) en clair. Tous les textes
 * secondaires qu'elle contient consomment --cpd-color-text-secondary (gray-900
 * #656d77), qui ne donne que 4,17:1 sur ce fond → échec RGAA AA (seuil 4,5:1).
 *
 * On repointe la variable sur la bulle ENTIÈRE, et non sur le seul timestamp :
 * les autres textes secondaires vivent dans packages/shared-components avec des
 * classes CSS-module hashées, donc sans sélecteur stable à cibler un par un.
 * Un seul scope couvre (retour de recette SCAT-33) :
 *   - .mx_MessageTimestamp                       (heure)
 *   - RedactedBodyView .content                  (« Message supprimé »)
 *   - TextualBodyView .annotation/.editedMarker  (« (modifié) », 12px)
 *
 * Technique : repoint de variable plutôt que surcharge de `color`, pour ne pas
 * entrer en conflit de spécificité avec les classes modules hashées.
 *
 * Ratio RGAA AA (texte normal, seuil 4,5:1) :
 *   gray-1000 #595e67 sur #dde5ff = 5,19:1 ✓
 *
 * Le pendant sombre vit dans la-bulle-dark/css/_la-bulle-dark-overrides.pcss :
 * ce fichier-ci n'est chargé que par la-bulle-light.pcss, une règle préfixée
 * .cpd-theme-dark y serait morte (c'était le cas avant SCAT-33).
 * Les bulles des autres (fond gris Compound) restent non affectées. */
.mx_EventTile[data-layout="bubble"][data-self="true"] {
    --cpd-color-text-secondary: var(--cpd-color-gray-1000); /* #595e67 → 5,19:1 sur #dde5ff */
}
