/* Page d'accueil de La Bulle (SCAT-53).
 * La classe .mx_HomePage reste portée par le conteneur : LandmarkNavigation la cible
 * pour donner le focus à la zone principale. Elle n'a plus de styles propres —
 * _HomePage.pcss a été supprimé avec la page d'accueil intégrée d'Element.
 */
.mx_HomePage_laBulle {
    width: 100%;
    padding: var(--cpd-space-10x) var(--cpd-space-8x);
    container-type: inline-size;
    container-name: homepage;
}

.mx_HomePage_laBulle_wrapper {
    display: flex;
    gap: var(--cpd-space-8x);
    align-items: flex-start;
    max-width: 1040px;
    margin: 0 auto;
}

.mx_HomePage_laBulle_content {
    flex: 1 1 auto;
    min-width: 0;
}

.mx_HomePage_laBulle_title {
    margin: 0;
    font: var(--cpd-font-heading-md-semibold);
    color: var(--cpd-color-text-primary);
}

.mx_HomePage_laBulle_intro {
    margin: var(--cpd-space-2x) 0 var(--cpd-space-6x);
    font: var(--cpd-font-body-md-regular);
    color: var(--cpd-color-text-secondary);
}

.mx_HomePage_laBulle_actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cpd-space-3x);
    margin-top: var(--cpd-space-8x);
}

/* Encart de téléchargement de l'application mobile */
.mx_HomePage_laBulle_download {
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 260px;
    padding: var(--cpd-space-5x);
    border-radius: var(--cpd-space-3x);
    background-color: var(--cpd-color-bg-subtle-secondary);
}

.mx_HomePage_laBulle_download_title {
    margin: 0 0 var(--cpd-space-4x);
    font: var(--cpd-font-body-lg-semibold);
    color: var(--cpd-color-text-primary);
}

.mx_HomePage_laBulle_download_card {
    padding: var(--cpd-space-4x);
    border-radius: var(--cpd-space-2x);
    background-color: var(--cpd-color-bg-canvas-default);
    text-align: center;
}

.mx_HomePage_laBulle_download_qr img {
    width: 130px;
    height: 130px;
}

.mx_HomePage_laBulle_download_hint {
    margin: var(--cpd-space-3x) 0 0;
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
}
