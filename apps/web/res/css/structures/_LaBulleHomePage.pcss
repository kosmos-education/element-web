/* Page d'accueil de La Bulle (SCAT-53).
 * La classe .mx_HomePage reste portée par le conteneur : LandmarkNavigation la cible
 * pour donner le focus à la zone principale. Elle n'a plus de styles propres —
 * _HomePage.pcss a été supprimé avec la page d'accueil intégrée d'Element.
 */
.mx_HomePage_laBulle {
    /* Element ne pose pas `box-sizing: border-box` globalement : sans cette ligne, la
     * page mesure 100 % de sa zone PLUS son padding, et déborde sur la droite. */
    box-sizing: border-box;
    /* Colonne dont le seul enfant porte des marges automatiques : le contenu est centré
     * dans la hauteur tant qu'il tient, et se cale en haut dès qu'il déborde — les marges
     * automatiques tombent à zéro faute d'espace libre. Un `align-items: center` aurait
     * rendu le haut de la page inatteignable au défilement. */
    display: flex;
    flex-direction: column;
    width: 100%;
    /* Hauteur bornée, sans quoi l'`overflow-y: auto` d'AutoHideScrollbar n'a rien à
     * faire défiler et le bas de la page devient inatteignable. Cf. le commentaire de
     * `.mx_MatrixChat > :not(…)` dans _MatrixChat.pcss : « needed height 100% all the
     * way down to the HomePage ». */
    height: 100%;
    /* Padding horizontal seulement : le padding vertical est porté par le wrapper, les
     * navigateurs ne traitant pas tous le `padding-bottom` d'un conteneur défilant de la
     * même façon — il finit rogné une fois arrivé en bas. */
    padding-inline: var(--cpd-space-8x);
    container-type: inline-size;
    container-name: homepage;

    /* Échelle de la page. Tout le reste — tailles de texte comme dimensions — en dérive
     * en `em`, ce qui garde constants les rapports de la maquette.
     *
     * Plancher : body-md, la taille de repos, jamais franchie vers le bas. Plafond : 18px,
     * atteint vers 1270px de large. Entre les deux, 0,55 % de la largeur du conteneur, soit
     * celle réellement disponible — elle dépend du panneau de salons, pas de la fenêtre.
     *
     * Les deux bornes sont en `rem` : le réglage « taille du texte » d'Element décale
     * l'ensemble vers le haut, comme sur le reste de l'application. */
    font-size: clamp(var(--cpd-font-size-body-md), calc(0.6875rem + 0.55cqi), 1.125rem);
}

/* La mise en page ne doit jamais dépendre du seul palier ci-dessous pour ne pas
 * déborder : le wrapper passe l'encart à la ligne dès qu'il ne tient plus, et chaque
 * élément de largeur fixe est plafonné à la place réellement disponible. */
.mx_HomePage_laBulle_wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cpd-space-8x);
    align-items: flex-start;
    max-width: 69.33em; /* 1040px à l'échelle de repos */
    margin: auto;
    padding-block: var(--cpd-space-10x);
}

.mx_HomePage_laBulle_content {
    /* Sous 30em de large, le contenu réclame la ligne entière et l'encart passe dessous. */
    flex: 1 1 30em;
    min-width: 0;
}

/* Les raccourcis `font` de Compound réinitialisent `font-size` et couperaient l'héritage
 * de l'échelle : la typographie passe ici par les tokens primitifs. */
.mx_HomePage_laBulle_title {
    margin: 0;
    font-weight: var(--cpd-font-weight-semibold);
    font-size: 1.6em; /* heading-md à l'échelle de repos */
    line-height: var(--cpd-font-line-height-tight);
    letter-spacing: var(--cpd-font-letter-spacing-heading-md);
    color: var(--cpd-color-text-primary);
}

.mx_HomePage_laBulle_intro {
    margin: var(--cpd-space-2x) 0 var(--cpd-space-6x);
    font-weight: var(--cpd-font-weight-regular);
    line-height: var(--cpd-font-line-height-regular);
    letter-spacing: var(--cpd-font-letter-spacing-body-md);
    color: var(--cpd-color-text-secondary);
}

.mx_HomePage_laBulle_actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cpd-space-3x);
    margin-top: var(--cpd-space-8x);

    /* Les boutons Compound figent leur taille dans un raccourci `font` : on ne surcharge
     * que `font-size`, pour qu'ils suivent l'échelle sans toucher à leur graisse. */
    > button,
    > a {
        font-size: 1em;
    }
}

/* Encart de téléchargement de l'application mobile. Affiché à toutes les tailles : il
 * porte une information — La Bulle existe dans l'application Skolengo — qui vaut aussi
 * pour quelqu'un déjà sur un petit écran. Il passe sous le contenu et rétrécit plutôt que
 * de disparaître. */
.mx_HomePage_laBulle_download {
    /* Ne grandit pas au-delà de sa largeur, mais rétrécit plutôt que de déborder. */
    flex: 0 1 17.33em; /* 260px à l'échelle de repos */
    box-sizing: border-box;
    max-width: 100%;
    padding: var(--cpd-space-5x);
    border-radius: var(--cpd-space-3x);
    background-color: var(--cpd-color-bg-subtle-secondary);
}

.mx_HomePage_laBulle_download_title {
    margin: 0 0 var(--cpd-space-4x);
    font-weight: var(--cpd-font-weight-semibold);
    font-size: 1.13em; /* body-lg à l'échelle de repos */
    line-height: var(--cpd-font-line-height-regular);
    letter-spacing: var(--cpd-font-letter-spacing-body-lg);
    color: var(--cpd-color-text-primary);
}

.mx_HomePage_laBulle_download_card {
    padding: var(--cpd-space-4x);
    border-radius: var(--cpd-space-2x);
    background-color: var(--cpd-color-bg-canvas-default);
    text-align: center;
}

.mx_HomePage_laBulle_download_qr img {
    width: min(8.67em, 100%); /* 130px à l'échelle de repos */
    height: auto;
}

.mx_HomePage_laBulle_download_hint {
    /* Le lien mène à la même page que le QR code. */
    a {
        color: var(--cpd-color-text-action-accent);
        text-decoration: underline;
    }

    margin: var(--cpd-space-3x) 0 0;
    font-weight: var(--cpd-font-weight-regular);
    font-size: 0.87em; /* body-sm à l'échelle de repos */
    line-height: var(--cpd-font-line-height-regular);
    letter-spacing: var(--cpd-font-letter-spacing-body-sm);
    color: var(--cpd-color-text-secondary);
}

/* Largeur intermédiaire : on fait passer l'encart sous le contenu avant même que le
 * wrapper n'y soit contraint, pour ne pas serrer les descriptions de salons.
 * La largeur observée est celle de la page, qui dépend du panneau de salons et pas
 * seulement de la fenêtre — d'où les container queries plutôt que des media queries. */
@container homepage (max-width: 899px) {
    .mx_HomePage_laBulle_content {
        flex-basis: 100%;
    }
}

/* Place réduite : on resserre les marges et on empile les boutons. */
@container homepage (max-width: 559px) {
    .mx_HomePage_laBulle {
        padding-inline: var(--cpd-space-4x);
    }

    .mx_HomePage_laBulle_wrapper {
        padding-block: var(--cpd-space-6x);
    }

    .mx_HomePage_laBulle_actions {
        flex-direction: column;
        align-items: stretch;
    }
}

/* Présentation des salons : purement descriptive, non cliquable */
.mx_HomePage_laBulle_rooms {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-5x);
    margin: 0;
    padding: 0;
    list-style: none;
}

.mx_HomePage_laBulle_room {
    display: flex;
    gap: var(--cpd-space-4x);
    align-items: flex-start;

    /* Les pastilles colorées font partie des SVG fournis : les redimensionner en bloc,
     * sans toucher à leurs proportions. */
    img {
        flex: 0 0 auto;
        width: 2.67em; /* 40px à l'échelle de repos */
        height: auto;
    }
}

.mx_HomePage_laBulle_room_name {
    display: block;
    font-weight: var(--cpd-font-weight-semibold);
    line-height: var(--cpd-font-line-height-regular);
    letter-spacing: var(--cpd-font-letter-spacing-body-md);
    color: var(--cpd-color-text-primary);
}

.mx_HomePage_laBulle_room_description {
    margin: var(--cpd-space-1x) 0 0;
    font-weight: var(--cpd-font-weight-regular);
    line-height: var(--cpd-font-line-height-regular);
    letter-spacing: var(--cpd-font-letter-spacing-body-md);
    color: var(--cpd-color-text-secondary);
}

/* Toujours seul sur sa ligne, donc toujours en dernier : en deux colonnes il passe sous
 * le contenu et l'encart, et en colonne unique l'encart s'intercale entre les boutons
 * et lui. L'espacement vient du `gap` du wrapper. */
.mx_HomePage_laBulle_logoRow {
    flex: 1 0 100%;
}

.mx_HomePage_laBulle_logo {
    display: block;
    width: min(13.67em, 100%); /* 205px à l'échelle de repos */
    height: auto;
}
